{
	"name": "polytoria-ts",
	"version": "3.0.4",
	"description": "A TypeScript-to-Luau Compiler for Polytoria :)",
	"main": "out/CLI/index.js",
	"browser": "out/CLI/browser.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/polytoria-ts/polytoria-ts.git"
	},
	"bin": {
		"ptsc": "out/CLI/cli.js"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tspc -b",
		"update-test-types": "cd tests && npm install github:polytoria-ts/compiler-types @polytoria-ts/types@latest && npm install",
		"test": "npm run build && npm run test-compile",
		"build-watch": "tspc -b -w",
		"eslint": "eslint --max-warnings 0",
		"devlink": "npm run build && cd devlink && npm link",
		"test-compile": "jest --coverage"
	},
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@roblox-ts/luau-ast": "=2.1.2",
		"@roblox-ts/path-translator": "=1.1.1",
		"@polytoria-ts/pojo-resolver": "=1.3.0",
		"chokidar": "^4.0.3",
		"fs-extra": "^11.4.1",
		"kleur": "^4.1.5",
		"resolve": "^1.22.13",
		"typescript": "=5.9.3",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.4",
		"@types/prompts": "^2.4.9",
		"@types/resolve": "^1.20.6",
		"@types/ts-expose-internals": "npm:@roblox-ts/ts-expose-internals@=5.9.3",
		"@types/yargs": "^17.0.35",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"jest": "^30.5.2",
		"jiti": "^2.7.0",
		"prettier": "^3.9.9",
		"ts-jest": "^29.4.14",
		"ts-node": "^10.9.2",
		"ts-patch": "^3.3.0",
		"typescript-eslint": "^8.71.1",
		"typescript-transform-paths": "^4.0.0"
	},
	"files": [
		"out",
		"include",
		"CHANGELOG.md",
		"!**/*.js.map",
		"!**/*.tsbuildinfo"
	]
}
